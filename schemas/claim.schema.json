{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/QuantumApplicationsCenter/qac-claims/schemas/claim.schema.json",
  "title": "QAC claim record (hand-curated; claims/<id>/claim.yaml)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "title",
    "short_title",
    "headline",
    "claim_type",
    "domain",
    "taxonomy",
    "source",
    "assertion",
    "assumptions_as_reported",
    "assessment",
    "review",
    "publication"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "Stable slug; must equal the directory name."
    },
    "title": {
      "type": "string",
      "minLength": 8,
      "maxLength": 200
    },
    "short_title": {
      "type": "string",
      "minLength": 3,
      "maxLength": 60
    },
    "headline": {
      "type": "string",
      "minLength": 20,
      "maxLength": 240,
      "description": "The one sentence a lay reader quotes. State the claim, not QAC's verdict."
    },
    "claim_type": {
      "enum": [
        "literature_resource_estimate",
        "vendor_roadmap",
        "demonstration",
        "advantage_claim"
      ]
    },
    "domain": {
      "enum": [
        "quantum_chemistry",
        "cryptanalysis",
        "optimization",
        "materials",
        "dynamics",
        "linear_algebra",
        "other"
      ]
    },
    "taxonomy": {
      "enum": [
        "application",
        "hardware-roadmap"
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "title",
        "authors",
        "year"
      ],
      "anyOf": [
        {
          "required": [
            "doi"
          ]
        },
        {
          "required": [
            "arxiv"
          ]
        },
        {
          "required": [
            "url"
          ]
        }
      ],
      "properties": {
        "type": {
          "enum": [
            "journal_article",
            "preprint",
            "press_release",
            "talk",
            "roadmap_document",
            "repository"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 8
        },
        "authors": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 2
          }
        },
        "author_list_complete": {
          "type": "boolean"
        },
        "year": {
          "type": "integer",
          "minimum": 1990,
          "maximum": 2100
        },
        "venue": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name"
          ],
          "properties": {
            "name": {
              "type": "string"
            },
            "volume": {
              "type": "string"
            },
            "article": {
              "type": "string"
            },
            "pages": {
              "type": "string"
            }
          }
        },
        "doi": {
          "type": "string",
          "pattern": "^10\\.[0-9]{4,9}/\\S+$"
        },
        "arxiv": {
          "type": "string",
          "pattern": "^[0-9]{4}\\.[0-9]{4,5}(v[0-9]+)?$"
        },
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        }
      }
    },
    "assertion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "what_is_claimed",
        "workload",
        "method",
        "architecture_assumed"
      ],
      "properties": {
        "what_is_claimed": {
          "type": "string",
          "minLength": 40
        },
        "workload": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "target_observable",
            "target_precision"
          ],
          "properties": {
            "system": {
              "type": "string"
            },
            "active_space_orbitals": {
              "type": "integer",
              "minimum": 1
            },
            "active_space_electrons": {
              "type": "integer",
              "minimum": 1
            },
            "target_observable": {
              "type": "string"
            },
            "target_precision": {
              "$ref": "#/$defs/numericFigure"
            }
          }
        },
        "method": {
          "type": "string",
          "minLength": 8
        },
        "architecture_assumed": {
          "type": "string",
          "minLength": 8
        }
      }
    },
    "assumptions_as_reported": {
      "type": "object",
      "description": "Assumptions exactly as the source states them, each with a locator (section/page/table).",
      "additionalProperties": {
        "anyOf": [
          {
            "$ref": "#/$defs/numericFigure"
          },
          {
            "$ref": "#/$defs/textFigure"
          }
        ]
      },
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]*$"
      }
    },
    "assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reproduction_status",
        "summary_plain",
        "what_this_shows",
        "what_this_does_not_show",
        "findings",
        "classical_status"
      ],
      "properties": {
        "reproduction_status": {
          "enum": [
            "not_attempted",
            "logical_counts_reproduced",
            "partially_reproduced",
            "fully_reproduced",
            "contested"
          ]
        },
        "summary_plain": {
          "type": "string",
          "minLength": 80,
          "maxLength": 900,
          "description": "May use {{ placeholders }} (see narrative.md); rendered at build time."
        },
        "what_this_shows": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 10
          }
        },
        "what_this_does_not_show": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 10
          }
        },
        "findings": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "aspect",
              "verdict",
              "note"
            ],
            "properties": {
              "aspect": {
                "enum": [
                  "logical_qubits",
                  "toffoli_count",
                  "t_count",
                  "physical_qubits",
                  "runtime_seconds",
                  "code_distance"
                ]
              },
              "verdict": {
                "enum": [
                  "matches",
                  "within_factor",
                  "differs",
                  "not_compared"
                ]
              },
              "note": {
                "type": "string",
                "minLength": 10
              }
            }
          }
        },
        "classical_status": {
          "enum": [
            "solved_classically",
            "not_solved_classically_at_target_accuracy",
            "contested",
            "unknown"
          ]
        },
        "classical_status_note": {
          "type": "string"
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "prepared_by",
        "reviewed_by",
        "approved_by",
        "information_cutoff"
      ],
      "properties": {
        "prepared_by": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/person"
          }
        },
        "reviewed_by": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/person"
          }
        },
        "approved_by": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/person"
          }
        },
        "information_cutoff": {
          "type": "string",
          "format": "date",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        }
      }
    },
    "publication": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "enum": [
            "draft",
            "review",
            "published",
            "retracted"
          ]
        },
        "first_published": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "links": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "label",
          "url"
        ],
        "properties": {
          "label": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "pattern": "^https://"
          }
        }
      }
    }
  },
  "$defs": {
    "unit": {
      "enum": [
        "count",
        "seconds",
        "hartree",
        "dimensionless",
        "bits",
        "nanoseconds"
      ]
    },
    "numericFigure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "unit",
        "locator"
      ],
      "properties": {
        "value": {
          "type": "number"
        },
        "unit": {
          "$ref": "#/$defs/unit"
        },
        "locator": {
          "type": "string",
          "minLength": 3,
          "description": "Where in the source this appears, e.g. 'Table V' or 'Sec. V, p. 14'."
        },
        "qualifier": {
          "enum": [
            "exact",
            "approximate",
            "upper_bound",
            "lower_bound",
            "rounded"
          ]
        },
        "note": {
          "type": "string"
        }
      }
    },
    "textFigure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "locator"
      ],
      "properties": {
        "value": {
          "type": "string",
          "minLength": 1
        },
        "locator": {
          "type": "string",
          "minLength": 3
        },
        "note": {
          "type": "string"
        }
      }
    },
    "person": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 3
        },
        "affiliation": {
          "type": "string"
        },
        "github": {
          "type": "string",
          "pattern": "^[A-Za-z0-9-]+$"
        },
        "date": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        }
      }
    }
  }
}
