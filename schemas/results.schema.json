{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/QuantumApplicationsCenter/qac-claims/schemas/results.schema.json",
  "title": "Machine-written reproduction results (reproductions/<id>/results.json)",
  "description": "Written by the reproduction's code (the final cell of notebook.ipynb, or reproduce.py). Never edited by hand. Every number the public record attributes to QAC comes from here.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "claim_id",
    "reproduction_id",
    "generated_at",
    "producer",
    "tooling",
    "inputs",
    "logical",
    "physical"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "claim_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "reproduction_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "generated_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entrypoint"
      ],
      "properties": {
        "entrypoint": {
          "enum": [
            "notebook.ipynb",
            "reproduce.py"
          ]
        },
        "cell_tag": {
          "type": "string"
        }
      }
    },
    "tooling": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "python",
        "packages"
      ],
      "properties": {
        "python": {
          "type": "string"
        },
        "packages": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "minProperties": 1,
          "description": "Exact versions of the packages that produced the numbers (e.g. qdk-chemistry, qdk)."
        }
      }
    },
    "inputs": {
      "oneOf": [
        {
          "$ref": "#/$defs/chemistryInputs"
        },
        {
          "$ref": "#/$defs/factoringInputs"
        }
      ]
    },
    "logical": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "num_qubits",
        "ccz_count",
        "ccix_count",
        "toffoli_count"
      ],
      "properties": {
        "walk_steps": {
          "type": "integer",
          "minimum": 1,
          "description": "Quantum-walk steps (qubitized phase estimation only)."
        },
        "num_qubits": {
          "type": "integer",
          "minimum": 1
        },
        "t_count": {
          "type": "integer",
          "minimum": 0
        },
        "rotation_count": {
          "type": "integer",
          "minimum": 0
        },
        "rotation_depth": {
          "type": "integer",
          "minimum": 0
        },
        "ccz_count": {
          "type": "integer",
          "minimum": 0
        },
        "ccix_count": {
          "type": "integer",
          "minimum": 0
        },
        "measurement_count": {
          "type": "integer",
          "minimum": 0
        },
        "toffoli_count": {
          "type": "integer",
          "minimum": 0,
          "description": "ccz_count + ccix_count"
        },
        "shots_expected": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Expected number of shots when the algorithm is repeated; toffoli_count then counts all expected shots."
        },
        "toffoli_count_per_shot": {
          "type": "integer",
          "minimum": 0,
          "description": "Toffoli gates in one shot, when shots_expected is given."
        }
      },
      "description": "Logical resource counts. walk_steps, t_count, rotation and measurement counts are recorded when the reproduction's tool produces them."
    },
    "physical": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "scenario_id",
          "architecture",
          "code",
          "factories",
          "synthesis",
          "physical_qubits",
          "compute_qubits",
          "factory_qubits",
          "memory_qubits",
          "runtime_seconds",
          "error_budget",
          "achieved_error"
        ],
        "properties": {
          "scenario_id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "architecture": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "physical_error_rate"
            ],
            "properties": {
              "physical_error_rate": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 1
              },
              "gate_time_ns": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "measurement_time_ns": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "reaction_time_ns": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            },
            "anyOf": [
              {
                "required": [
                  "gate_time_ns",
                  "measurement_time_ns"
                ]
              },
              {
                "required": [
                  "reaction_time_ns"
                ]
              }
            ]
          },
          "code": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "family",
              "distance",
              "cycle_time_ns"
            ],
            "properties": {
              "family": {
                "enum": [
                  "surface"
                ]
              },
              "distance": {
                "type": "integer",
                "minimum": 3
              },
              "distance_source": {
                "enum": [
                  "imposed",
                  "selected_by_tool"
                ]
              },
              "cycle_time_ns": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            }
          },
          "factories": {
            "type": "string",
            "minLength": 1
          },
          "synthesis": {
            "type": "string",
            "minLength": 1
          },
          "physical_qubits": {
            "type": "integer",
            "minimum": 1
          },
          "compute_qubits": {
            "type": "integer",
            "minimum": 0
          },
          "factory_qubits": {
            "type": "integer",
            "minimum": 0
          },
          "memory_qubits": {
            "type": "integer",
            "minimum": 0
          },
          "runtime_seconds": {
            "type": "number",
            "exclusiveMinimum": 0,
            "description": "Total runtime of the computation the claim describes (all expected shots, when the algorithm is repeated)."
          },
          "error_budget": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 1
          },
          "achieved_error": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "runtime_seconds_per_shot": {
            "type": "number",
            "exclusiveMinimum": 0,
            "description": "Runtime of one shot, when the algorithm is repeated."
          }
        }
      }
    },
    "logical_variants": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "case_id",
          "inputs",
          "logical"
        ],
        "properties": {
          "case_id": {
            "type": "string",
            "minLength": 1
          },
          "inputs": {
            "$ref": "#/$defs/chemistryInputs"
          },
          "logical": {
            "$ref": "#/properties/logical"
          }
        }
      }
    },
    "layout": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "walk_steps",
        "toffolis_per_walk",
        "toffoli_count",
        "peak_data_qubits",
        "stage_count"
      ],
      "description": "Half-angle layout counts, distinct from the table implementation in logical.",
      "properties": {
        "walk_steps": {
          "type": "integer",
          "minimum": 1
        },
        "toffolis_per_walk": {
          "type": "integer",
          "minimum": 1
        },
        "toffoli_count": {
          "type": "integer",
          "minimum": 1
        },
        "peak_data_qubits": {
          "type": "integer",
          "minimum": 1
        },
        "stage_count": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  },
  "$defs": {
    "chemistryInputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hamiltonian",
        "target_precision_hartree",
        "trial_state"
      ],
      "properties": {
        "hamiltonian": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "orbitals",
            "electrons"
          ],
          "properties": {
            "kind": {
              "enum": [
                "synthetic_dfthc",
                "molecular_dfthc",
                "molecular_df",
                "thc_cost_model"
              ]
            },
            "orbitals": {
              "type": "integer",
              "minimum": 1
            },
            "electrons": {
              "type": "integer",
              "minimum": 1
            },
            "R": {
              "type": "integer"
            },
            "B": {
              "type": "integer"
            },
            "C": {
              "type": "integer"
            },
            "lambda_eff": {
              "type": "number"
            },
            "coefficient_bit_precision": {
              "type": "integer"
            },
            "rotation_bit_precision": {
              "type": "integer"
            },
            "seed": {
              "type": "integer"
            },
            "thc_rank": {
              "type": "integer",
              "minimum": 1
            },
            "lambda_value": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "kind": {
                    "const": "thc_cost_model"
                  }
                }
              },
              "then": {
                "required": [
                  "thc_rank",
                  "lambda_value"
                ]
              }
            }
          ]
        },
        "target_precision_hartree": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "trial_state": {
          "type": "string"
        }
      },
      "description": "Inputs of a chemistry (Hamiltonian simulation) reproduction."
    },
    "factoringInputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "factoring"
      ],
      "description": "Inputs of an integer-factoring reproduction.",
      "properties": {
        "factoring": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "modulus_bits",
            "algorithm",
            "parameters"
          ],
          "properties": {
            "kind": {
              "enum": [
                "rsa"
              ]
            },
            "modulus_bits": {
              "type": "integer",
              "minimum": 2
            },
            "algorithm": {
              "type": "string",
              "minLength": 3,
              "description": "The algorithm being costed, e.g. 'Eker\u00e5\u2013H\u00e5stad period finding with approximate residue arithmetic'."
            },
            "parameters": {
              "type": "object",
              "minProperties": 1,
              "description": "The algorithm's parameters as the source names them (e.g. s, window sizes).",
              "propertyNames": {
                "pattern": "^[a-z][a-z0-9_]*$"
              },
              "additionalProperties": {
                "type": [
                  "number",
                  "string"
                ]
              }
            }
          }
        }
      }
    }
  }
}
