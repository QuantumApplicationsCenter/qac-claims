{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/QuantumApplicationsCenter/qac-claims/schemas/results.schema.json",
  "title": "Machine-written reproduction results (reproductions/<id>/results.json)",
  "description": "Written by the reproduction's code (the final cell of notebook.ipynb, or reproduce.py). Never edited by hand. Every number the public record attributes to QAC comes from here.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "claim_id",
    "reproduction_id",
    "generated_at",
    "producer",
    "tooling",
    "inputs",
    "logical",
    "physical"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "claim_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "reproduction_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "generated_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entrypoint"
      ],
      "properties": {
        "entrypoint": {
          "enum": [
            "notebook.ipynb",
            "reproduce.py"
          ]
        },
        "cell_tag": {
          "type": "string"
        }
      }
    },
    "tooling": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "python",
        "packages"
      ],
      "properties": {
        "python": {
          "type": "string"
        },
        "packages": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "required": [
            "qdk-chemistry",
            "qdk"
          ]
        }
      }
    },
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hamiltonian",
        "target_precision_hartree",
        "trial_state"
      ],
      "properties": {
        "hamiltonian": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "orbitals",
            "electrons"
          ],
          "properties": {
            "kind": {
              "enum": [
                "synthetic_dfthc",
                "molecular_dfthc",
                "molecular_df",
                "molecular_integrals"
              ]
            },
            "orbitals": {
              "type": "integer",
              "minimum": 1
            },
            "electrons": {
              "type": "integer",
              "minimum": 1
            },
            "R": {
              "type": "integer"
            },
            "B": {
              "type": "integer"
            },
            "C": {
              "type": "integer"
            },
            "lambda_eff": {
              "type": "number"
            },
            "coefficient_bit_precision": {
              "type": "integer"
            },
            "rotation_bit_precision": {
              "type": "integer"
            },
            "seed": {
              "type": "integer"
            },
            "source_url": {
              "type": "string",
              "pattern": "^https://",
              "description": "Where the reproduction fetched the molecular integrals (kind molecular_integrals)."
            },
            "source_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$",
              "description": "SHA-256 of the integral file, checked by the reproduction before use."
            },
            "pauli_coefficient_threshold": {
              "type": "number",
              "minimum": 0,
              "description": "Pauli terms with a smaller absolute coefficient are dropped."
            }
          }
        },
        "target_precision_hartree": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "trial_state": {
          "type": "string"
        },
        "trotter": {
          "type": "object",
          "description": "Inputs of a product-formula (Trotter-Suzuki) phase-estimation cost model. Present only for Trotter-based reproductions.",
          "additionalProperties": false,
          "required": [
            "order",
            "trotter_number",
            "phase_estimation_constant"
          ],
          "properties": {
            "order": {
              "type": "integer",
              "minimum": 1
            },
            "trotter_number": {
              "type": "number",
              "exclusiveMinimum": 0,
              "description": "Steps per unit of evolution time (1/Hartree) that keep the Trotter error at the reference accuracy."
            },
            "trotter_number_reference_accuracy_hartree": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "phase_estimation_constant": {
              "type": "number",
              "exclusiveMinimum": 0,
              "description": "alpha in M = alpha / (epsilon * t): applications of the step unitary needed to resolve the energy to epsilon."
            },
            "synthesis_t_per_rotation_slope": {
              "type": "number",
              "description": "gamma in T gates per rotation = gamma * log2(1 / synthesis error) + delta."
            },
            "synthesis_t_per_rotation_offset": {
              "type": "number",
              "description": "delta in T gates per rotation = gamma * log2(1 / synthesis error) + delta."
            },
            "error_budget_rule": {
              "type": "string"
            },
            "error_budget_phase_estimation_hartree": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "error_budget_trotter_hartree": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "error_budget_synthesis_hartree": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "logical_t_gate_time_ns": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          }
        }
      }
    },
    "logical": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "walk_steps",
        "num_qubits",
        "t_count",
        "rotation_count",
        "rotation_depth",
        "ccz_count",
        "ccix_count",
        "measurement_count",
        "toffoli_count"
      ],
      "properties": {
        "walk_steps": {
          "type": "integer",
          "minimum": 1,
          "description": "Applications of the step unitary inside phase estimation: quantum-walk steps for qubitization, Trotter steps for product formulas."
        },
        "num_qubits": {
          "type": "integer",
          "minimum": 1
        },
        "t_count": {
          "type": "integer",
          "minimum": 0
        },
        "rotation_count": {
          "type": "integer",
          "minimum": 0
        },
        "rotation_depth": {
          "type": "integer",
          "minimum": 0
        },
        "ccz_count": {
          "type": "integer",
          "minimum": 0
        },
        "ccix_count": {
          "type": "integer",
          "minimum": 0
        },
        "measurement_count": {
          "type": "integer",
          "minimum": 0
        },
        "toffoli_count": {
          "type": "integer",
          "minimum": 0,
          "description": "ccz_count + ccix_count"
        },
        "pauli_terms": {
          "type": "integer",
          "minimum": 1,
          "description": "Non-identity Pauli terms in the qubit Hamiltonian (Trotter-based reproductions)."
        },
        "rotations_per_step": {
          "type": "integer",
          "minimum": 1,
          "description": "Arbitrary-angle rotations in one application of the step unitary (Trotter-based reproductions)."
        },
        "t_states_per_rotation": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Average T gates per arbitrary-angle rotation under the synthesis model named in the inputs."
        },
        "t_count_after_synthesis": {
          "type": "integer",
          "minimum": 0,
          "description": "T gates after every rotation is compiled to Clifford+T: t_count plus the T gates from rotation_count."
        },
        "runtime_seconds_at_logical_t_rate": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "t_count_after_synthesis times inputs.trotter.logical_t_gate_time_ns: the source's logical-level runtime convention, with no error-correction model."
        }
      }
    },
    "diagnostics": {
      "type": "object",
      "description": "Named cross-check values the reproduction computes so that a narrative can quote them. They are not headline figures and are never compared with the source automatically.",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]*$"
      },
      "additionalProperties": {
        "type": "number"
      }
    },
    "physical": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "scenario_id",
          "architecture",
          "code",
          "factories",
          "synthesis",
          "physical_qubits",
          "compute_qubits",
          "factory_qubits",
          "memory_qubits",
          "runtime_seconds",
          "error_budget",
          "achieved_error"
        ],
        "properties": {
          "scenario_id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "architecture": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "physical_error_rate",
              "gate_time_ns",
              "measurement_time_ns"
            ],
            "properties": {
              "physical_error_rate": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 1
              },
              "gate_time_ns": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "measurement_time_ns": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            }
          },
          "code": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "family",
              "distance",
              "cycle_time_ns"
            ],
            "properties": {
              "family": {
                "enum": [
                  "surface"
                ]
              },
              "distance": {
                "type": "integer",
                "minimum": 3
              },
              "distance_source": {
                "enum": [
                  "imposed",
                  "selected_by_tool"
                ]
              },
              "cycle_time_ns": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            }
          },
          "factories": {
            "type": "string",
            "minLength": 1
          },
          "synthesis": {
            "type": "string",
            "minLength": 1
          },
          "physical_qubits": {
            "type": "integer",
            "minimum": 1
          },
          "compute_qubits": {
            "type": "integer",
            "minimum": 0
          },
          "factory_qubits": {
            "type": "integer",
            "minimum": 0
          },
          "memory_qubits": {
            "type": "integer",
            "minimum": 0
          },
          "runtime_seconds": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "error_budget": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 1
          },
          "achieved_error": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    }
  }
}
